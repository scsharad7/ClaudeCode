# ============================================================
# Stock Spike Alert Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# EMAIL (Gmail recommended — use an App Password, not your
# regular Gmail password)
#
# How to get a Gmail App Password:
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification (required)
#   3. Search for "App Passwords" → select "Mail" + "Other"
#   4. Copy the 16-character password shown
# ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=scsharad7@gmail.com
SENDER_PASSWORD=tnyk gprz rlnh zriv   # 16-char App Password (spaces OK)
RECIPIENT_EMAIL=scsharad7@gmail.com@gmail.com

# ----------------------------------------------------------
# TWILIO SMS
# Free trial: twilio.com/try-twilio
#   - After signup, go to Console Dashboard for SID + Token
#   - Your Twilio phone number is listed under Phone Numbers
#   - Verified caller ID = your real mobile number
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=AC9eee4e240f3a5863a095499bc58dcefb
TWILIO_AUTH_TOKEN=04c541627a3555fd9988e4308990f7c7
TWILIO_FROM_NUMBER=+18555630647   # your Twilio number
TWILIO_TO_NUMBER=+18574987658     # your real mobile number
TWILLIO_RECOVERY_CODE=J84ZHPQY6ME42GJ5TKSFTJ57 # Recovery Code Generated during the account setup

# ----------------------------------------------------------
# Alert thresholds (optional — defaults shown)
# ----------------------------------------------------------
MIN_SCORE_FOR_ALERT=65      # minimum score to send email
MIN_SCORE_FOR_SMS=80        # minimum score to also send SMS
ALERT_COOLDOWN_HOURS=4      # hours before re-alerting same ticker

# ----------------------------------------------------------
# Signal sensitivity (optional — defaults shown)
# ----------------------------------------------------------
PREMARKET_MOVE_PCT=5.0         # % pre-market move to trigger signal
UNUSUAL_VOLUME_MULTIPLIER=3.0  # x average volume to flag
GAP_UP_PCT=3.0                 # % gap at open to flag
BREAKOUT_NEARNESS_PCT=1.5      # % within 52-week high to flag breakout
SHORT_SQUEEZE_DTC_THRESHOLD=5.0
IV_SPIKE_MULTIPLIER=1.5

# ----------------------------------------------------------
# Scan schedule (optional — defaults shown)
# ----------------------------------------------------------
PREMARKET_SCAN_INTERVAL_MINUTES=5    # 4:00 AM – 10:00 AM ET
REGULAR_SCAN_INTERVAL_MINUTES=15     # 10:00 AM – 4:00 PM ET
PREMARKET_START_HOUR=4
INTENSIVE_END_HOUR=10
MARKET_CLOSE_HOUR=16
TIMEZONE=America/New_York
LOG_FILE=alerts.log
