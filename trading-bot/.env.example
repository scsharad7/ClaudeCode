# Alpaca API credentials (get from alpaca.markets → Paper Trading → API Keys)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
PAPER_TRADING=true

# Risk management
MAX_DAILY_LOSS_USD=200        # Bot stops trading if you lose more than this in a day
RISK_PER_TRADE_PCT=1.0        # % of portfolio per trade (1% = conservative)
MAX_POSITION_SIZE_USD=1000    # Hard cap per trade in dollars

# Server
SERVER_PORT=8000
WEBHOOK_SECRET=                # Optional: set a secret to validate TradingView webhooks
